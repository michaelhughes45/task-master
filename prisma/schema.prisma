generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  timezone      String? // IANA name, e.g. "America/New_York"; null until set from the browser (treated as UTC)
  reviewNotify  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  tasks    Task[]
  events   Event[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum TaskScope {
  DAILY
  WEEKLY
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  notes     String?
  scope     TaskScope
  priority  Priority  @default(NORMAL)
  date      DateTime  @db.Date // DAILY: the day; WEEKLY: the Monday of the week (first occurrence if repeating)
  rrule     String? // RFC 5545 RRULE part, e.g. "FREQ=WEEKLY;BYDAY=MO,WE"; null = does not repeat
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions TaskCompletion[]
  exceptions  TaskException[]

  @@index([userId, date])
}

// One changed or cancelled occurrence of a repeating task, keyed by its original date.
model TaskException {
  id             String    @id @default(cuid())
  taskId         String
  occurrenceDate DateTime  @db.Date
  cancelled      Boolean   @default(false)
  title          String? // overrides; null = unchanged
  date           DateTime? @db.Date // moved to another day

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, occurrenceDate])
}

model TaskCompletion {
  id             String   @id @default(cuid())
  taskId         String
  occurrenceDate DateTime @db.Date // which day (DAILY) or week's Monday (WEEKLY) the task was for
  completedAt    DateTime @default(now()) // when it was ticked (UTC)
  minutesSpent   Int?
  workNote       String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, occurrenceDate])
}

enum EventColor {
  BLUE
  GREEN
}

model Event {
  id        String     @id @default(cuid())
  userId    String
  title     String
  notes     String?
  location  String?
  color     EventColor @default(BLUE)
  allDay    Boolean    @default(false)
  // Timed: UTC instants. All-day: the first day and the day after the last day (exclusive),
  // each at 00:00 UTC; read back with fromDbDate, never in the user's timezone.
  startAt   DateTime
  endAt     DateTime
  // RFC 5545 RRULE part; null = does not repeat. Expanded on the start's wall time in the
  // user's timezone (floating), so DST doesn't move the event.
  rrule     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exceptions EventException[]

  @@index([userId, startAt])
}

// One changed or cancelled occurrence of a repeating event, keyed by its original start.
model EventException {
  id              String    @id @default(cuid())
  eventId         String
  occurrenceStart DateTime // the occurrence's original start instant
  cancelled       Boolean   @default(false)
  title           String? // overrides; null = unchanged
  startAt         DateTime?
  endAt           DateTime?
  location        String?
  notes           String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceStart])
}
